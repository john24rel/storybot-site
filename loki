name: TF: Auto Diff (version-only) & Plan (env from changed tfvars)

on:
  pull_request:
    branches: [ main ]   # change to 'master' if needed
  workflow_dispatch:

permissions:
  contents: write          # commit plan-<env>.txt back to the PR branch
  pull-requests: write     # post/update PR comments
  id-token: write          # REQUIRED for OIDC → AWS role assumption
  actions: read

# Match your manual workflow defaults / envs
env:
  terraform_version: "~> 1.8"    # passed to Terra-Factory reusable workflow
  terra_factory_aws_id: dat-con  # your account selector used by Terra-Factory
  terraform_root: "dms-infra"    # TF root folder (same warning: don't rename after infra exists)
  TFVARS_DIR: ./terraform/environment
  BOT_TAG_DIFF: "<!-- terraform-common-tf-version-diff -->"
  BOT_TAG_PLAN: "<!-- terraform-tfvars-plan -->"

jobs:
  detect:
    name: Detect changes & choose environment
    runs-on: ubuntu-latest
    outputs:
      run_plan: ${{ steps.out.outputs.run_plan }}
      picked_env: ${{ steps.out.outputs.picked_env }}
      changed_common_tf: ${{ steps.out.outputs.changed_common_tf }}
    steps:
      - name: Checkout (full history)
        uses: actions/checkout@v4
        with: { fetch-depth: 0 }

      - name: Base/Head SHAs
        id: shas
        shell: bash
        run: |
          if [ -n "${{ github.event.pull_request.base.sha }}" ]; then
            echo "base=${{ github.event.pull_request.base.sha }}" >> $GITHUB_OUTPUT
            echo "head=${{ github.event.pull_request.head.sha }}" >> $GITHUB_OUTPUT
          else
            git fetch origin main
            echo "base=$(git rev-parse origin/main)" >> $GITHUB_OUTPUT
            echo "head=$(git rev-parse HEAD)"        >> $GITHUB_OUTPUT
          fi

      - name: Detect relevant changes & pick environment (your rules)
        id: decide
        shell: bash
        run: |
          BASE="${{ steps.shas.outputs.base }}"
          HEAD="${{ steps.shas.outputs.head }}"
          TFVARS_DIR="${{ env.TFVARS_DIR }}"

          echo "Changed files:"
          git diff --name-only "$BASE" "$HEAD" | tee changed.txt || true

          # List of changed tfvars under terraform/environment/**
          TFVARS_CHANGED_LIST=$(git diff --name-only "$BASE" "$HEAD" -- "${TFVARS_DIR}"/*.tfvars || true)
          printf "%s\n" $TFVARS_CHANGED_LIST > tfvars_changed.txt

          # Any *.tf changed anywhere under terraform/ ?
          if git diff --name-only "$BASE" "$HEAD" -- 'terraform/**/*.tf' | grep -q '\.tf$'; then
            CHANGED_TF_FILES=true
          else
            CHANGED_TF_FILES=false
          fi

          # Did terraform/common.tf change? (for version-only diff comment)
          if git diff --name-only "$BASE" "$HEAD" -- 'terraform/common.tf' | grep -q 'common.tf'; then
            CHANGED_COMMON_TF=true
          else
            CHANGED_COMMON_TF=false
          fi

          # Decide if plan should run:
          # - run if any tfvars changed OR any *.tf changed
          if [ -s tfvars_changed.txt ] || [ "$CHANGED_TF_FILES" = "true" ]; then
            RUN_PLAN=true
          else
            RUN_PLAN=false
          fi

          # Pick environment from changed tfvars
          PICKED="dev"  # default
          mapfile -t CHANGED_TFVARS < tfvars_changed.txt
          count=${#CHANGED_TFVARS[@]}

          if [ "$count" -eq 1 ]; then
            fname=$(basename "${CHANGED_TFVARS[0]}")
            base="${fname%.tfvars}"
            case "$base" in
              dev|preprod|prod|test) PICKED="$base" ;;
              *) PICKED="dev" ;; # e.g., common.tfvars → default dev
            esac
          elif [ "$count" -gt 1 ]; then
            # Multiple tfvars (or "all files") → force dev
            PICKED="dev"
          else
            # No tfvars changed: if only *.tf changed, we still plan with dev
            PICKED="dev"
          fi

          echo "RUN_PLAN=$RUN_PLAN"
          echo "PICKED_ENV=$PICKED"
          echo "CHANGED_COMMON_TF=$CHANGED_COMMON_TF"

          echo "run_plan=$RUN_PLAN"               >> $GITHUB_OUTPUT
          echo "picked_env=$PICKED"               >> $GITHUB_OUTPUT
          echo "changed_common_tf=$CHANGED_COMMON_TF" >> $GITHUB_OUTPUT

      - name: Save outputs
        id: out
        run: |
          echo "run_plan=${{ steps.decide.outputs.run_plan }}" >> $GITHUB_OUTPUT
          echo "picked_env=${{ steps.decide.outputs.picked_env }}" >> $GITHUB_OUTPUT
          echo "changed_common_tf=${{ steps.decide.outputs.changed_common_tf }}" >> $GITHUB_OUTPUT

  # ---------- Separate PR comment: version-only diff from terraform/common.tf ----------
  diff_comment:
    name: PR Comment — common.tf version-only diff
    runs-on: ubuntu-latest
    needs: [detect]
    if: needs.detect.outputs.changed_common_tf == 'true'
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }

      - name: Base/Head SHAs
        id: shas
        shell: bash
        run: |
          if [ -n "${{ github.event.pull_request.base.sha }}" ]; then
            echo "base=${{ github.event.pull_request.base.sha }}" >> $GITHUB_OUTPUT
            echo "head=${{ github.event.pull_request.head.sha }}" >> $GITHUB_OUTPUT
          else
            git fetch origin main
            echo "base=$(git rev-parse origin/main)" >> $GITHUB_OUTPUT
            echo "head=$(git rev-parse HEAD)"        >> $GITHUB_OUTPUT
          fi

      - name: Build version-only diff
        id: build
        shell: bash
        run: |
          git diff "${{ steps.shas.outputs.base }}" "${{ steps.shas.outputs.head }}" -- 'terraform/common.tf' > full_common.diff || true
          # Keep only lines that touch versions / refs (tweak patterns as needed)
          awk '/^[-+].*required_version|^[-+].*required_providers|^[-+].*version[[:space:]]*=|^[-+].*source.*\?ref=/' full_common.diff > version_only.diff || true

          if [ -s version_only.diff ]; then
            {
              echo "## Version Changes in terraform/common.tf"
              echo
              echo '```diff'
              cat version_only.diff
              echo '```'
            } > version_only.md
            echo "has=true" >> $GITHUB_OUTPUT
          else
            echo "has=false" >> $GITHUB_OUTPUT
          fi

      - name: Post/Update PR comment — common.tf version diff
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const tag = process.env.BOT_TAG_DIFF;
            const has = '${{ steps.build.outputs.has }}' === 'true';
            const body = has
              ? [tag, fs.readFileSync('version_only.md','utf8')].join('\n')
              : [tag, 'No version-related changes found in **terraform/common.tf**.'].join('\n');

            const { data: comments } = await github.rest.issues.listComments({
              issue_number: context.payload.pull_request.number,
              owner: context.repo.owner,
              repo: context.repo.repo
            });
            const mine = comments.find(c => c.user?.login === 'github-actions[bot]' && c.body?.includes(tag));
            if (mine) {
              await github.rest.issues.updateComment({ comment_id: mine.id, owner: context.repo.owner, repo: context.repo.repo, body });
            } else {
              await github.rest.issues.createComment({ issue_number: context.payload.pull_request.number, owner: context.repo.owner, repo: context.repo.repo, body });
            }

  # ---------- Run Terra-Factory reusable workflow (your "same logic" plan) ----------
  terra_factory_plan:
    name: Terra-Factory Plan (env = ${{ needs.detect.outputs.picked_env }})
    needs: [detect]
    if: needs.detect.outputs.run_plan == 'true'
    uses: cobank-acb/cpe-terra-factory/.github/workflows/terra-factory.yml@main
    secrets: inherit
    with:
      terraform_version: ${{ env.terraform_version }}
      terraform_action: plan
      environment: ${{ needs.detect.outputs.picked_env }}
      terra_factory_aws_id: ${{ env.terra_factory_aws_id }}
      terraform_root: ${{ env.terraform_root }}

  # ---------- Capture plan output locally (same assumed role) + separate PR comment ----------
  local_plan_capture:
    name: Capture & Comment Plan (env = ${{ needs.detect.outputs.picked_env }})
    runs-on: ubuntu-latest
    needs: [detect]
    if: needs.detect.outputs.run_plan == 'true'
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }

      # Reuse the same OIDC → STS assume-role path Terra-Factory uses
      - name: Configure AWS credentials (Terra-Factory composite)
        id: configure-aws
        uses: cobank-acb/cpe-terra-factory/.github/actions/configure-aws@main
        with:
          aws_region: us-west-2
          environment: ${{ needs.detect.outputs.picked_env }}
          terra_factory_aws_id: ${{ env.terra_factory_aws_id }}
          terraform_action: plan

      - name: WhoAmI (AWS)
        run: |
          aws sts get-caller-identity
          aws configure list

      - name: Setup Terraform (runner local)  # pin a concrete TF version for local plan capture
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
          terraform_version: "1.8.4"

      - name: Terraform Init
        run: terraform -chdir="${{ env.terraform_root }}" init -input=false

      - name: Terraform Plan (with <env>.tfvars) — capture stdout
        id: plan
        shell: bash
        run: |
          mkdir -p .tfplan
          ENV="${{ needs.detect.outputs.picked_env }}"
          TFVARS_PATH="${{ env.TFVARS_DIR }}/${ENV}.tfvars"
          if [ ! -f "$TFVARS_PATH" ]; then
            echo "Missing tfvars: $TFVARS_PATH"
            exit 1
          fi
          OUT_TXT=".tfplan/plan-${ENV}.txt"
          terraform -chdir="${{ env.terraform_root }}" plan -no-color -input=false -var-file="../${TFVARS_PATH}" | tee "$OUT_TXT"
          {
            echo "### Terraform Plan (${ENV}.tfvars)"
            echo
            echo '```text'
            cat "$OUT_TXT"
            echo '```'
          } > ".tfplan/plan-${ENV}.md"
          echo "out_txt=$OUT_TXT" >> $GITHUB_OUTPUT
          echo "out_md=.tfplan/plan-${ENV}.md" >> $GITHUB_OUTPUT

      - name: Commit plan-<env>.txt to PR branch (no email configured)
        run: |
          OUT_TXT="${{ steps.plan.outputs.out_txt }}"
          git config user.name "github-actions[bot]"
          git add "$OUT_TXT"
          if ! git diff --cached --quiet; then
            git commit -m "chore(ci): add terraform plan stdout (${{ needs.detect.outputs.picked_env }})"
            git push
          else
            echo "No changes to commit."
          fi

      - name: Post/Update PR comment — Terraform Plan (<env>)
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const tag = process.env.BOT_TAG_PLAN;
            const body = [tag, fs.readFileSync('${{ steps.plan.outputs.out_md }}','utf8')].join('\n');

            const { data: comments } = await github.rest.issues.listComments({
              issue_number: context.payload.pull_request.number,
              owner: context.repo.owner,
              repo: context.repo.repo
            });
            const mine = comments.find(c => c.user?.login === 'github-actions[bot]' && c.body?.includes(tag));
            if (mine) {
              await github.rest.issues.updateComment({ comment_id: mine.id, owner: context.repo.owner, repo: context.repo.repo, body });
            } else {
              await github.rest.issues.createComment({ issue_number: context.payload.pull_request.number, owner: context.repo.owner, repo: context.repo.repo, body });
            }
